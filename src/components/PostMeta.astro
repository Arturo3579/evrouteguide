---
export interface Props {
  date: string;
}

const { date } = Astro.props;
---
<div class="post-meta">
  <span class="update-date">Updated {date}</span>
  <span class="sep">·</span>
  <span class="review-badge">Reviewed every month</span>
  <span class="sep">·</span>
  <span>EV Route Guide</span>
</div>
