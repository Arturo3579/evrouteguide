                <td>8 yr / 100,000 mi</td>
                <td>70% retention</td>
                <td>Mustang Mach-E and F-150 Lightning</td>
              </tr>
              <tr>
                <td>Hyundai / Kia</td>
                <td>10 yr / 100,000 mi</td>
                <td>70% retention</td>
                <td>One of the longest standard warranties</td>
              </tr>
              <tr>
                <td>Chevrolet</td>
                <td>8 yr / 100,000 mi</td>
