---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy Policy";
const description = "Privacy policy for EV Route Guide. How we collect, use, and protect your personal information.";
---

<BaseLayout title={title} description={description}>
  <div class="page-content">
    <header class="page-header">
      <h1 class="page-title">Privacy Policy</h1>
      <p class="page-lead">Last updated: July 31, 2026</p>
    </header>

    <div class="page-body">
      <h2>1. Information We Collect</h2>
      <p>We collect minimal information to operate this website:</p>
      <ul>
        <li><strong>Usage data:</strong> Pages visited, time on site, approximate location (country/state level) via Google Analytics.</li>
        <li><strong>Cookies:</strong> Small text files stored on your device to remember preferences and serve relevant advertising.</li>
        <li><strong>Voluntary submissions:</strong> If you contact us via email, we retain your email address and message content.</li>
      </ul>

      <h2>2. How We Use Information</h2>
      <p>We use collected data to:</p>
      <ul>
        <li>Understand which guides are most helpful and improve content quality.</li>
        <li>Display relevant advertising through Google AdSense.</li>
        <li>Respond to user inquiries and feedback.</li>
      </ul>

      <h2>3. Third-Party Services</h2>
      <p>We use the following third-party services that may collect data:</p>
      <ul>
        <li><strong>Google Analytics:</strong> For traffic analysis. See <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Google's Privacy Policy</a>.</li>
        <li><strong>Google AdSense:</strong> For advertising. See <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener">Google's Ads Policy</a>.</li>
        <li><strong>Hosting (Vercel):</strong> For serving the website. See <a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener">Vercel's Privacy Policy</a>.</li>
      </ul>

      <h2>4. Your Rights</h2>
      <p>Depending on your location, you may have rights to:</p>
      <ul>
        <li>Request access to your personal data.</li>
        <li>Request deletion of your personal data.</li>
        <li>Opt out of personalized advertising via <a href="https://adssettings.google.com/" target="_blank" rel="noopener">Google Ad Settings</a>.</li>
      </ul>

      <h2>5. Contact</h2>
      <p>Privacy-related questions: <a href="mailto:thor19daniel@gmail.com">thor19daniel@gmail.com</a></p>
    </div>
  </div>
</BaseLayout>
