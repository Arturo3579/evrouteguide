---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "EV Route Guide";
const description = "Honest guides, cost calculators and practical tools for electric vehicle owners in the United States. Compare EVs vs gas cars, calculate real charging costs, and find the best home charger.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero">
    <h1 class="hero-title">Own an EV without the guesswork</h1>
    <p class="hero-subtitle">
      Real cost comparisons, charging guides, and honest reviews for electric vehicle owners in the United States. No manufacturer hype, just numbers that matter.
    </p>
    <div class="hero-cta">
      <a href="/calculator" class="btn btn-primary">Calculate your savings</a>
      <a href="/guides" class="btn btn-secondary">Browse guides</a>
    </div>
  </section>

  <!-- Calculator Teaser -->
  <section class="reveal">
    <h2 class="section-heading">EV vs Gas: Real Cost Calculator</h2>
    <div class="tool-form">
      <div class="form-row">
        <div class="form-group">
          <label for="miles-per-year">Miles driven per year</label>
          <input type="number" id="miles-per-year" value="12000" min="1000" max="100000" step="1000" />
        </div>
        <div class="form-group">
          <label for="gas-price">Gas price per gallon ($)</label>
          <input type="number" id="gas-price" value="3.50" min="1.00" max="10.00" step="0.10" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="electricity-rate">Electricity rate per kWh ($)</label>
          <input type="number" id="electricity-rate" value="0.14" min="0.05" max="0.50" step="0.01" />
        </div>
        <div class="form-group">
          <label for="mpg">Gas car MPG</label>
          <input type="number" id="mpg" value="28" min="10" max="60" step="1" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="ev-efficiency">EV efficiency (miles per kWh)</label>
          <input type="number" id="ev-efficiency" value="3.5" min="2.0" max="5.0" step="0.1" />
        </div>
      </div>
      <button class="btn btn-primary" id="calc-btn" style="width:100%;margin-top:0.5rem;">Calculate annual cost</button>
    </div>

    <div class="tool-result" id="result-box" style="display:none;">
      <h3>Your estimated annual fuel cost</h3>
      <div class="result-grid">
        <div class="result-item">
          <div class="label">Gas car</div>
          <div class="value" id="res-gas">—</div>
        </div>
        <div class="result-item">
          <div class="label">Electric car</div>
          <div class="value" id="res-ev">—</div>
        </div>
        <div class="result-item">
          <div class="label">Annual savings</div>
          <div class="value" id="res-save">—</div>
        </div>
        <div class="result-item">
          <div class="label">Savings per mile</div>
          <div class="value" id="res-per-mile">—</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Cards -->
  <section>
    <h2 class="section-heading reveal">What we cover</h2>
    <div class="hub-grid">
      <div class="hub-card reveal reveal-delay-1">
        <div class="hub-card-icon">
          <img src="/images/icons/category-buying-guides.webp" alt="" width="52" height="52" loading="lazy" />
        </div>
        <h3>Buying Guides</h3>
        <p>Honest comparisons of the best electric cars, trucks and SUVs for every budget. No manufacturer sponsorships.</p>
        <ul>
          <li><a href="/guides/best-electric-cars-under-35000">Best EVs under $35,000</a></li>
          <li><a href="/guides/electric-car-vs-hybrid">EV vs Hybrid: which to buy?</a></li>
        </ul>
      </div>

      <div class="hub-card reveal reveal-delay-2">
        <div class="hub-card-icon">
          <img src="/images/icons/category-charging-battery.webp" alt="" width="52" height="52" loading="lazy" />
        </div>
        <h3>Charging &amp; Battery</h3>
        <p>Everything about home charging, public networks, battery life, and real charging costs. Written to last years.</p>
        <ul>
          <li><a href="/guides/how-long-do-ev-batteries-last">How long do EV batteries last?</a></li>
          <li><a href="/guides/cost-to-charge-ev-at-home">Cost to charge at home</a></li>
        </ul>
      </div>

      <div class="hub-card reveal reveal-delay-1">
        <div class="hub-card-icon">
          <img src="/images/icons/category-costs-ownership.webp" alt="" width="52" height="52" loading="lazy" />
        </div>
        <h3>Total Cost of Ownership</h3>
        <p>Real numbers on insurance, maintenance, depreciation, and hidden costs. See if an EV actually saves you money.</p>
        <ul>
          <li><a href="/guides/ev-maintenance-vs-gas">EV maintenance vs gas cars</a></li>
          <li><a href="/guides/hidden-costs-of-evs">Hidden costs of owning an EV</a></li>
        </ul>
      </div>

      <div class="hub-card reveal reveal-delay-2">
        <div class="hub-card-icon">
          <img src="/images/icons/category-home-charging.webp" alt="" width="52" height="52" loading="lazy" />
        </div>
        <h3>Home Charging Setup</h3>
        <p>Which wallbox to buy, installation costs, electrical panel requirements, and HOA rules for condos and apartments.</p>
        <ul>
          <li><a href="/guides/best-home-ev-chargers">Best home EV chargers</a></li>
          <li><a href="/guides/install-ev-charger-cost">Cost to install a home charger</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="about-section">
    <div class="about-box">
      <h2>About EV Route Guide</h2>
      <p>We don't take money from car manufacturers or charging companies. Our guides are based on real ownership experience, public data, and hands-on testing. If we recommend a product, it's because we tried it — not because someone paid us.</p>
    </div>
  </section>

  <script>
    const fmt = (n) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(n);

    document.getElementById('calc-btn').addEventListener('click', () => {
      const miles = parseFloat(document.getElementById('miles-per-year').value) || 0;
      const gasPrice = parseFloat(document.getElementById('gas-price').value) || 0;
      const elecRate = parseFloat(document.getElementById('electricity-rate').value) || 0;
      const mpg = parseFloat(document.getElementById('mpg').value) || 1;
      const evEff = parseFloat(document.getElementById('ev-efficiency').value) || 1;

      const gasCost = (miles / mpg) * gasPrice;
      const kWhNeeded = miles / evEff;
      const evCost = kWhNeeded * elecRate;
      const savings = gasCost - evCost;
      const perMile = savings / miles;

      document.getElementById('res-gas').textContent = fmt(gasCost);
      document.getElementById('res-ev').textContent = fmt(evCost);
      document.getElementById('res-save').textContent = fmt(savings);
      document.getElementById('res-per-mile').textContent = fmt(perMile);
      document.getElementById('result-box').style.display = 'block';
    });

    document.getElementById('calc-btn').click();
  </script>
</BaseLayout>
