---

<BaseLayout title={title} description={description}>
  <div class="page-content">
    <header class="page-header guides-hero">
      <h1 class="page-title">EV Guides</h1>
      <p class="page-lead">Honest, evergreen guides written for real EV owners in the United States. No sponsored content, no manufacturer talking points.</p>
    </header>

    {categories.map((cat) => (
      <section class="guide-category reveal">
        <div class="category-header">
          <div class="category-icon" style={`background: ${cat.bg}; color: ${cat.color}`}>
            <Fragment set:html={cat.icon} />
          </div>
          <h2 class="category-title">{cat.name}</h2>
        </div>

        <div class="guide-grid">
          {cat.guides.map((guide) => (
            <a href={`/guides/${guide.slug}`} class="guide-card">
              <div class="guide-card-image">
                {guide.hasImage ? (
                  <img src={guide.image} alt={guide.title} loading="lazy" />
                ) : (
                  <div class="guide-placeholder" style={`background: ${cat.bg}`}>
                    <div class="placeholder-icon" style={`color: ${cat.color}`}>
                      <Fragment set:html={guide.placeholderIcon} />
                    </div>
                  </div>
                )}
              </div>
              <div class="guide-card-body">
                <h3 class="guide-card-title">{guide.title}</h3>
                <p class="guide-card-desc">{guide.desc}</p>
                <span class="guide-card-cta" style={`color: ${cat.color}`}>
                  Read guide <span class="cta-arrow">→</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <style>
    .guides-hero {
      text-align: center;
      max-width: 640px;
      margin: 0 auto 3rem;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 2rem;
    }

    .guide-category {
      margin-bottom: 3.5rem;
    }

    .category-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .category-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .category-icon svg {
      width: 20px;
      height: 20px;
    }

    .category-title {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--color-text);
      margin: 0;
    }

    .guide-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .guide-card {
      display: flex;
      flex-direction: row;
      align-items: stretch;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-card);
      overflow: hidden;
      transition: all 0.25s ease;
      text-decoration: none;
    }

    .guide-card:hover {
      box-shadow: 0 8px 30px var(--color-shadow-lg);
      border-color: transparent;
      transform: translateY(-2px);
    }

    .guide-card:hover .guide-card-title {
      color: var(--color-primary);
    }

    .guide-card:hover .cta-arrow {
      transform: translateX(4px);
    }

    .guide-card-image {
      width: 140px;
      min-width: 140px;
      flex-shrink: 0;
      overflow: hidden;
    }

    .guide-card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .guide-placeholder {
      width: 100%;
      height: 100%;
      min-height: 120px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .placeholder-icon svg {
      width: 36px;
      height: 36px;
      opacity: 0.6;
    }

    .guide-card-body {
      padding: 1.25rem 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .guide-card-title {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 700;
      line-height: 1.35;
      margin-bottom: 0.4rem;
      color: var(--color-text);
      letter-spacing: -0.01em;
      transition: color 0.2s;
    }

    .guide-card-desc {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      line-height: 1.6;
      margin-bottom: 0.75rem;
    }

    .guide-card-cta {
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      margin-top: auto;
    }

    .cta-arrow {
      transition: transform 0.2s;
      display: inline-block;
    }

    @media (min-width: 640px) {
      .guide-grid {
        grid-template-columns: 1fr 1fr;
      }

      .guide-card-image {
        width: 160px;
        min-width: 160px;
      }
    }

    @media (min-width: 768px) {
      .guide-grid {
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
      }

      .guide-card-image {
        width: 180px;
        min-width: 180px;
      }
    }
  </style>
</BaseLayout>
